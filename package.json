{
  "name": "scaffold-yard-v1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "backup": "node scripts/backup.js",
    "seed:demo": "node scripts/seed-demo.js",
    "benchmark": "node scripts/benchmark.js",
    "check": "node scripts/check.js",
    "benchmark:movement": "node scripts/movement-writes.js",
    "typecheck": "tsc -p tsconfig.json",
    "benchmark:smoke": "node scripts/benchmark.js --containers=200 --ledger=2000 --gate-ms=250 && node scripts/movement-writes.js --seconds=5 --warmup=2",
    "restore-drill": "node scripts/restore-drill.js",
    "decrypt-backup": "node scripts/decrypt-backup.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  }
}
