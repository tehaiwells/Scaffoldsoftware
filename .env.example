# Set these in your shell; no dotenv dependency is required.
PORT=3000
# Leave HOST unset: the server then listens on this PC only (127.0.0.1), or on the local network when
# "Let phones on this Wi-Fi open Scaffold Yard" is switched on in Account. Setting HOST overrides that choice.
# HOST=127.0.0.1
# Leave DATABASE_PATH unset to use the default: %LOCALAPPDATA%\ScaffoldYard\scaffold.sqlite on Windows, ./data/scaffold.sqlite elsewhere.
# DATABASE_PATH=./data/scaffold.sqlite
# Automatic daily backups go to ./data/backups unless BACKUP_DIR is set.
# BACKUP_DIR=./data/backups
# Only enable behind HTTPS when deploying:
COOKIE_SECURE=false
# Extra host names this server answers (comma-separated), e.g. the name of an HTTPS proxy in front of it. Any other Host gets 421.
# SCAFFOLD_HOSTS=yard.example.com
# The server administrator (sees file paths, backs up the whole server, changes This computer settings).
# Unset: whoever created the first company on this server. Set: that account, which must already exist or be made on the first start;
# once the server has users nobody can make an account with that email (by invitation or sign-up).
# SCAFFOLD_ADMIN_EMAIL=owner@example.com
# 1 lets anyone who can open the page create a company (the browser test suite uses it). Leave unset on a real server.
# SCAFFOLD_OPEN_REGISTRATION=1
